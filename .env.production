# Build-time analytics config for the production bundle.
#
# This file is committed on purpose, and it is the whole fix for a bug that
# left soulchain.net with no analytics at all.
#
# Vite inlines import.meta.env.VITE_* at BUILD time. The key used to live only
# in wrangler.jsonc "vars", which are Cloudflare Worker RUNTIME bindings — the
# build never sees them — and in .env.local, which is gitignored and therefore
# absent on the build machine. So VITE_POSTHOG_KEY resolved to undefined in CI,
# isAnalyticsEnabled() returned false, and the shipped bundle contained no key
# and made no requests. Local builds worked, which is what hid it.
#
# A PostHog project key is publishable: posthog-js ships it to every browser,
# so committing it leaks nothing. Only publishable values belong in this file —
# never a personal API key, and never a Polar or auth secret.
VITE_POSTHOG_KEY=phc_XHqnnRkUqEWxKuTpuqEbhtRhUxcCf4p5ywgUtwBH3aA

# Telemetry goes through the first-party /ingest proxy (worker/index.ts,
# vercel.json, server/index.ts). analytics.ts already defaults to /ingest; this
# is here so the value is visible rather than implicit.
VITE_POSTHOG_HOST=/ingest

# Where the PostHog app lives, for toolbar and "view recording" links.
VITE_POSTHOG_UI_HOST=https://us.posthog.com

# Polar product ids for the BROWSER.
#
# The paywall renders its Subscribe links from these. The client reads
# import.meta.env.VITE_POLAR_PRODUCT_*, which Vite inlines at build time; its
# other branch (process.env.POLAR_PRODUCT_*) cannot run in a browser. The six
# un-prefixed POLAR_PRODUCT_* in wrangler.jsonc are Worker runtime bindings and
# are what the Worker uses to create the checkout — the build never sees them.
#
# Without these the client resolved undefined, every `href` became undefined,
# and all six Subscribe buttons rendered disabled: the paywall sold nothing.
#
# Not secret: a product id appears in every checkout URL. They must stay equal
# to the POLAR_PRODUCT_* values in wrangler.jsonc — the Worker rejects a
# product it is not configured to sell, so a mismatch fails the checkout.
VITE_POLAR_PRODUCT_LITE_MONTH=83e71254-95df-48f3-a8d3-f02ecd5b51a4
VITE_POLAR_PRODUCT_LITE_YEAR=09442f06-a270-4a89-a5c7-deebd3b471a1
VITE_POLAR_PRODUCT_STANDARD_MONTH=a93c997a-c621-4d53-9870-4d021b52625a
VITE_POLAR_PRODUCT_STANDARD_YEAR=ce263ca8-53c6-41ee-8873-23dd820de99a
VITE_POLAR_PRODUCT_PRO_MONTH=33816df6-ad51-4471-99e0-222474b9bc5b
VITE_POLAR_PRODUCT_PRO_YEAR=1775a0c6-ff37-40bc-8d23-ed27ce6c3932

# Tells the client it is the production Polar environment, so the sandbox
# product-id fallbacks stay withheld (see client/src/funnel/lib/config.ts).
VITE_POLAR_SERVER=production
