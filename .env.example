VITE_APP_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=polar_oat_Bp4BGqrr5z5F8ggAtOH4lK7QQZJ1PUuC9kt0i2R5EE4
POLAR_WEBHOOK_SECRET=
SUCCESS_URL=http://localhost:3000/success?checkout_id={CHECKOUT_ID}

POLAR_PRODUCT_LITE_MONTH=ed645dbc-b203-4918-a8d1-9ae31dc068df
POLAR_PRODUCT_LITE_YEAR=e533fd93-72a2-41ec-9a8e-420ef2454481
POLAR_PRODUCT_STANDARD_MONTH=4aa020b5-a785-43ec-b864-a87c92c2933c
POLAR_PRODUCT_STANDARD_YEAR=144a19c9-17d4-40c4-96bd-3f3aa0efaea4
POLAR_PRODUCT_PRO_MONTH=7f3523f0-19ec-4ffe-b60c-0250b73058d0
POLAR_PRODUCT_PRO_YEAR=00d7d1fa-fc55-4731-91bb-db3bafdd05c8

# All of these go through the production gateway at backend.soulchain.net, which
# strips the prefix it matched before forwarding. The doubled segment in
# COMMUNITIES_REQUEST_URL is therefore correct, not a typo: the gateway consumes
# the first `/communities`, the service's own route supplies the second. Never
# add a trailing slash — the gateway 307s those to a path missing the prefix.
AUTH_API_BASE_URL=https://backend.soulchain.net/auth
AUTH_RESEND_VERIFICATION_URL=https://backend.soulchain.net/auth/api/auth/resend-verification
# AUTH_REGISTER_URL=https://backend.soulchain.net/auth/api/auth/register
# AUTH_VERIFY_OTP_URL=https://backend.soulchain.net/auth/api/auth/verify-email
# AUTH_JOIN_COMMUNITY_BY_CODE_URL=https://backend.soulchain.net/communities/join-community-by-code
COMMUNITIES_REQUEST_URL=https://backend.soulchain.net/communities/communities/request/lead

# The lead form posts to /api/communities/request by default, which the worker
# (or the BFF in dev) forwards to the upstream above. Set this only to bypass
# that and call an upstream directly.
# VITE_COMMUNITY_REQUEST_URL=/api/communities/request

SUBSCRIPTION_API_BASE_URL=https://backend.soulchain.net/onboarding
# PLANS_WEB_URL=https://backend.soulchain.net/onboarding/plans/web

ENTITLEMENT_TOKEN_SECRET=dev-only-insecure-secret-change-me
VITE_APP_DEEPLINK_SCHEME=epiminded
VITE_APP_UNIVERSAL_LINK=https://open.epiminded.app
NEXT_PUBLIC_APP_DEEPLINK_SCHEME=epiminded
NEXT_PUBLIC_APP_UNIVERSAL_LINK=https://open.epiminded.app

# PostHog analytics. This is the PROJECT TOKEN (phc_...), the value
# posthog.init() takes. It is publishable — posthog-js ships it to the browser —
# but lives here so it is not hardcoded and can differ per deployment.
# Unset it to disable analytics entirely. VITE_POSTHOG_TOKEN also works.
VITE_POSTHOG_KEY=phc_oapD477u256t56e6DqBFgfxW5Vhb875sfi37m4x5pKTi
# Telemetry goes through the first-party reverse proxy (see vercel.json,
# worker/index.ts, server/index.ts and the Vite dev proxy) so ad blockers,
# which match *.posthog.com, do not drop it. Set this to
# https://us.i.posthog.com to bypass the proxy when debugging.
VITE_POSTHOG_HOST=/ingest
# The PostHog app itself — used for toolbar and replay links, which must not
# be built against our own domain.
VITE_POSTHOG_UI_HOST=https://us.posthog.com
