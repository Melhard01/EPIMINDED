{
  // Cloudflare Worker config for the EpiMinded marketing site.
  //
  // Stack note: this repo is Vite + Express BFF + a Cloudflare Worker that
  // serves static assets and proxies a few edge routes. It is NOT Next.js /
  // OpenNext. Auth/checkout (`/api/auth/*`, Polar) run on the Express BFF in
  // local/Node deploys — they are not handled by this Worker.
  //
  // Non-secret config from .env.local is committed here for production.
  // Secrets stay in the Cloudflare dashboard / `wrangler secret` so
  // `keep_vars` preserves them across deploys:
  //   POLAR_WEBHOOK_SECRET, ENTITLEMENT_TOKEN_SECRET
  // Also set SUCCESS_URL in the dashboard to your production success URL
  // (do not commit localhost).

  "name": "epiminded-website",
  "compatibility_date": "2024-01-01",

  // Never let a deploy delete what the dashboard holds.
  "keep_vars": true,

  "main": "worker/index.ts",

  // Run the full client build before every deploy. A plain `vite build` ships
  // only the SPA shell, so every URL would serve the home page's canonical and
  // an empty #root; build:client also prerenders one HTML file per public page
  // plus dist/public/app-shell.html, the fallback the Worker serves below.
  "build": {
    "command": "pnpm run build:client"
  },

  "assets": {
    "directory": "./dist/public",

    // Deliberately absent: "not_found_handling". Setting it to
    // "single-page-application" makes the asset layer answer every unmatched
    // request itself, with dist/public/index.html under a 200, and the Worker
    // never runs. In production that meant:
    //
    //   /assets/index-<old hash>.js  -> HTML, so a browser holding markup from
    //       an earlier deploy got a document where its module should be. The
    //       parser dies on `<!doctype html>`, the app never hydrates, and the
    //       page renders correctly styled with every section still at
    //       `opacity: 0`. A stylesheet that missed was rejected on MIME type,
    //       leaving the page unstyled. Both are intermittent, because they
    //       need a client whose cached HTML predates the current deploy.
    //   /ingest/*  -> HTML instead of PostHog's script, so analytics never
    //       loaded at all.
    //   /api/*     -> 405, since the asset layer refuses POST.
    //   any unknown URL -> the prerendered home page, with its canonical and
    //       no noindex: a soft 404 under every wrong path, and the funnel
    //       steps got the home page rather than app-shell.
    //
    // With it unset, an unmatched request falls through to the Worker, which
    // already routes /ingest, the API, and the SPA fallback, and now 404s a
    // file that does not exist.
    "binding": "ASSETS",

    // Only WebP images go through the Worker, so it can hand a PNG/JPEG twin
    // to clients that cannot decode WebP (Safari < 14). Every other asset is
    // still served by the asset layer without the Worker running.
    "run_worker_first": ["/assets/*.webp"]
  },

  "vars": {
    "POLAR_SERVER": "production",
    // Production Polar token, committed as a var by explicit decision after
    // the trade-off was spelled out: vars live in git and are pushed to both
    // remotes, so this value is public to anyone with repo access and stays
    // in history even if the line is later removed. Rotating it in Polar is
    // the only way to revoke it.
    //
    // To move it out of git later, delete this line and run:
    //     wrangler secret put POLAR_ACCESS_TOKEN
    // keep_vars above means the deploy will not clear the dashboard value.
    "POLAR_ACCESS_TOKEN": "polar_oat_yNj22NgcRao4LLpYV4huuJtc7FzxNaG6wY8Pb1Wu8VI",

    "POLAR_PRODUCT_LITE_MONTH": "83e71254-95df-48f3-a8d3-f02ecd5b51a4",
    "POLAR_PRODUCT_LITE_YEAR": "09442f06-a270-4a89-a5c7-deebd3b471a1",
    "POLAR_PRODUCT_STANDARD_MONTH": "a93c997a-c621-4d53-9870-4d021b52625a",
    "POLAR_PRODUCT_STANDARD_YEAR": "ce263ca8-53c6-41ee-8873-23dd820de99a",
    "POLAR_PRODUCT_PRO_MONTH": "33816df6-ad51-4471-99e0-222474b9bc5b",
    "POLAR_PRODUCT_PRO_YEAR": "79e6bb1f-33a2-4f72-9a46-face47b66659",

    "AUTH_API_BASE_URL": "https://backend.soulchain.net/auth",
    "AUTH_RESEND_VERIFICATION_URL": "https://backend.soulchain.net/auth/api/auth/resend-verification",

    // Express BFF name; Worker lead-form override uses COMMUNITY_UPSTREAM_URL.
    "COMMUNITIES_REQUEST_URL": "https://backend.soulchain.net/communities/communities/request/lead",
    "COMMUNITY_UPSTREAM_URL": "https://backend.soulchain.net/communities/communities/request/lead",

    "SUBSCRIPTION_API_BASE_URL": "https://backend.soulchain.net/onboarding",

    "VITE_APP_DEEPLINK_SCHEME": "epiminded",
    "VITE_APP_UNIVERSAL_LINK": "https://open.epiminded.app",
    "NEXT_PUBLIC_APP_DEEPLINK_SCHEME": "epiminded",
    "NEXT_PUBLIC_APP_UNIVERSAL_LINK": "https://open.epiminded.app",

    // PostHog project token is publishable (shipped to the browser by posthog-js).
    "VITE_POSTHOG_KEY": "phc_oapD477u256t56e6DqBFgfxW5Vhb875sfi37m4x5pKTi",
    "VITE_POSTHOG_HOST": "/ingest",
    "VITE_POSTHOG_UI_HOST": "https://us.posthog.com"
  }
}
